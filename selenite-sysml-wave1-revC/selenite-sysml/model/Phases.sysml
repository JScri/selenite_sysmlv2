package SelenitePhases {
    doc /* Programme phase enumeration, P0 through P14+.
         * Source: Extended Timeline v3 (selenite_extended_timeline_v3.html),
         * MTL Guide v18, Strategy v3.1 — baseline ECN-019 Rev C + ECN-020.
         * P14 approximates the 2.5 Mt/yr REO steady state (~Y180). */

    enum def Phase {
        P0; P1; P2; P3; P4; P5; P6; P7;
        P8; P9; P10; P11; P12; P13; P14;
    }
}
